# TrafficMind AI EDGE PC configuration (copy to backend/.env on the Windows PC)
# Do not commit this file after adding real values.

# Set both URLs to the NEW Render backend URL after it is deployed.
AI_CAMERA_CONFIG_URL=https://YOUR-RENDER-BACKEND.onrender.com/api/ai-camera-config
LIVE_UPDATE_URL=https://YOUR-RENDER-BACKEND.onrender.com/api/live-update

# Must match INTERNAL_AI_KEY configured on the Node.js backend.
INTERNAL_AI_KEY=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_BACKEND

# The edge MJPEG server is local-only because the current stream handler
# has no viewer authentication. Do not port-forward port 5050.
TRAFFIC_STREAM_HOST=127.0.0.1
TRAFFIC_STREAM_PORT=5050
TRAFFIC_HEADLESS=true

# RTSP startup/recovery tuning.
TRAFFIC_RTSP_RECONNECT_COOLDOWN=5
TRAFFIC_RTSP_STALE_FRAME_TIMEOUT=8
TRAFFIC_RTSP_CONNECT_GRACE_PERIOD=20
TRAFFIC_PHASE28_CAMERA_REFRESH_ENABLED=true
TRAFFIC_PHASE28_CAMERA_REFRESH_INTERVAL=30
